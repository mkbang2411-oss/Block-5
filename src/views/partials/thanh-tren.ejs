<%# thanh nút phía trên: Ra phố | (tuỳ trang) | Đăng nhập (khi chưa chọn vai; ra phố là tự thoát vai) %>
<div class="thanh">
  <a class="nut nut-phu" href="/">Ra phố</a>
  <div class="tabs">
    <% if (locals.tabs) { tabs.forEach(function (t) { %>
      <a class="nut tab<%= t.on ? ' on' : '' %>" href="<%= t.href %>"><%= t.label %></a>
    <% }) } %>
  </div>
  <div class="tabs">
    <% if (locals.themHref) { %><a class="nut" href="<%= themHref %>"><%= themLabel %></a><% } %>
    <% if (!role) { %><a class="nut nut-phu" href="/login">Đăng nhập</a><% } %>
  </div>
</div>
