<!doctype html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= title %></title>
<meta name="description" content="Cái Quán Ăn - quán ăn Hội An: xem thực đơn, chọn món trên bàn tròn và gọi món.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<%# phông chữ tải không chặn việc vẽ trang (trước đó Lighthouse báo chặn ~0.8s); chưa tải xong thì dùng phông hệ thống rồi tự đổi %>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Alfa+Slab+One&family=Be+Vietnam+Pro:wght@400;600&family=Playfair+Display:wght@600;700&display=swap" onload="this.onload=null;this.rel='stylesheet'">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Alfa+Slab+One&family=Be+Vietnam+Pro:wght@400;600&family=Playfair+Display:wght@600;700&display=swap"></noscript>
<link rel="stylesheet" href="/css/style.css">
<%# hướng chuyển cảnh từ trang trước (len | xuong): đặt sớm để trang đích không bị chớp trước khi cành cây chạy %>
<script>try{var h=sessionStorage.getItem("huong");if(h)document.documentElement.setAttribute("data-vao",h);if(sessionStorage.getItem("dia"))document.documentElement.setAttribute("data-dia","1")}catch(e){}</script>
</head>
<%# la: có lá bay (trang phố) | am: kiểu âm nền của trang (pho | khach | bep | quan) %>
<body<%- locals.la ? ' data-la' : '' %> data-am="<%= locals.am || 'quan' %>">
<button class="nut nut-phu nut-am" id="nut-am" aria-label="Bật/tắt âm thanh">🔊</button>
<svg width="0" height="0" style="position:absolute" aria-hidden="true"><filter id="thuy-mac"><feTurbulence type="fractalNoise" baseFrequency=".02 .03" numOctaves="3" seed="3" result="n"/><feDisplacementMap in="SourceGraphic" in2="n" scale="7"/></filter></svg>
