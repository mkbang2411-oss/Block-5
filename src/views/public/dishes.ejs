<%- include('../partials/head', { title: 'Danh sách món ăn', am: 'quan' }) %>
<div class="nen"></div><div class="mo"></div>
<main class="man bep cuon">
  <%- include('../partials/thanh-tren', { themHref: '/khach', themLabel: 'Bàn chọn món' }) %>
  <%# link giữ nguyên từ khóa tìm kiếm khi sang trang / chọn món %>
  <% const lk = (extra) => '?' + new URLSearchParams(Object.assign(q ? { q } : {}, extra)).toString(); %>
  <div class="chia<%= sel ? ' co-chon' : '' %>" id="chia">
    <div class="cot-luoi">
      <div class="dau-khach">
        <h2>Danh sách món ăn</h2>
        <%- include('../partials/tim-kiem', { action: '/dishes', q, placeholder: 'Tìm theo tên món...' }) %>
      </div>
      <% if (!dishes.length) { %>
        <p class="trong-lop">Không có món nào<%= q ? ` khớp với "${q}"` : '' %>.</p>
      <% } else { %>
      <div class="luoi">
        <% dishes.forEach((d, i) => { %>
          <a class="o<%= d.id === sel ? ' chon' : '' %>" data-id="<%= d.id %>" href="<%= lk({ page, sel: d.id }) %>" title="Bấm để xem chi tiết">
            <span class="bieu"><%- dishThumb(d, i < 6, i < 3) %></span>
            <b><%= d.name %></b>
            <small><%= formatPrice(d.price) %> · <%= d.category %></small>
            <small><%= d.chef ? 'Đầu bếp ' + d.chef.name : '' %></small>
            <span class="the <%= d.available ? 'ok' : 'het' %>"><%= d.available ? 'Còn bán' : 'Hết món' %></span>
          </a>
        <% }) %>
      </div>
      <% } %>
      <%- include('../partials/phan-trang', { page, totalPages, lk }) %>
    </div>

    <%# khung chi tiết bên hông: giống bên đầu bếp nhưng chỉ xem, không có nguyên liệu %>
    <aside class="chi-tiet" aria-label="Chi tiết">
      <% dishes.forEach(d => { %>
      <section class="ct hop" data-id="<%= d.id %>" <%= d.id === sel ? '' : 'hidden' %>>
        <button type="button" class="dong-ct" data-a="dong" aria-label="Đóng">×</button>
        <div class="ct-xem">
          <div class="ct-dau"><span class="bieu"><%- dishThumb(d) %></span><h2><%= d.name %></h2></div>
          <dl class="ct-ds">
            <dt>Giá</dt><dd><%= formatPrice(d.price) %></dd>
            <dt>Mô tả</dt><dd><%= d.description || '—' %></dd>
            <dt>Danh mục</dt><dd><%= d.category || '—' %></dd>
            <dt>Tình trạng</dt><dd><span class="the <%= d.available ? 'ok' : 'het' %>"><%= d.available ? 'Còn bán' : 'Hết món' %></span></dd>
            <dt>Đầu bếp</dt><dd><%= d.chef ? d.chef.name + (d.chef.specialty ? ' (' + d.chef.specialty + ')' : '') : '—' %></dd>
          </dl>
        </div>
      </section>
      <% }) %>
    </aside>
  </div>
</main>
<%- include('../partials/foot', { scripts: ['/js/admin.js'] }) %>
