<%- include('../partials/head', { title: 'Quản trị ' + r.title, am: 'bep' }) %>
<div class="nen"></div><div class="mo"></div>
<main class="man bep cuon">
  <%- include('_nav', { active: r.key, themHref: '/admin/' + r.key + '/new', themLabel: '+ Thêm ' + r.singular }) %>
  <% if (flash) { %><div class="bao bao-tinh"><%= flash %></div><% } %>
  <div class="chia<%= sel ? ' co-chon' : '' %>" id="chia">
    <%# giữ từ khóa tìm kiếm khi sang trang / chọn mục %>
    <% const lk = (extra) => '?' + new URLSearchParams(Object.assign(q ? { q } : {}, extra)).toString(); %>
    <div class="cot-luoi">
      <div class="dau-khach">
        <%- include('../partials/tim-kiem', { action: '/admin/' + r.key, q, placeholder: 'Tìm theo tên ' + r.singular + '...' }) %>
      </div>
      <% if (!rows.length) { %>
        <p class="trong-lop"><%= q ? 'Không có ' + r.singular + ' nào khớp với "' + q + '".' : 'Chưa có ' + r.singular + ' nào. Bấm “Thêm” để tạo mới.' %></p>
      <% } else { %>
      <div class="luoi">
        <% rows.forEach(row => { const t = r.tile(row); %>
          <a class="o<%= row.id === sel ? ' chon' : '' %>" data-id="<%= row.id %>" href="<%= lk({ page, sel: row.id }) %>" title="Bấm để xem chi tiết">
            <span class="bieu"><%- t.icon %></span><b><%= t.title %></b><small><%= t.sub %></small>
          </a>
        <% }) %>
      </div>
      <% } %>
      <%# dãy trang luôn hiện, kể cả khi chỉ có 1 trang %>
      <nav class="phan-trang" aria-label="Phân trang">
        <% if (page === 1) { %><span class="nut nut-phu tat">&lt;</span><% } else { %><a class="nut nut-phu" href="<%= lk({ page: page - 1 }) %>" aria-label="Trang trước">&lt;</a><% } %>
        <% for (let n = 1; n <= totalPages; n++) { %>
          <a class="nut <%= n === page ? 'on' : 'nut-phu' %>" href="<%= lk({ page: n }) %>"><%= n %></a>
        <% } %>
        <% if (page === totalPages) { %><span class="nut nut-phu tat">&gt;</span><% } else { %><a class="nut nut-phu" href="<%= lk({ page: page + 1 }) %>" aria-label="Trang sau">&gt;</a><% } %>
      </nav>
    </div>

    <%# Khung chi tiết: mỗi món một khối, JS chỉ bật/tắt; server vẫn dựng sẵn khối đang chọn (kể cả khi form sửa báo lỗi) %>
    <aside class="chi-tiet" aria-label="Chi tiết">
      <% rows.forEach(row => {
        const dangSua = sua && row.id === sel;
        const values = dangSua ? sua.values : r.toValues(row);
        const errors = dangSua ? sua.errors : {};
        const t = r.tile(row);
        const lyDo = chan[row.id] || (row.id === sel && loi) || null;
      %>
      <section class="ct hop<%= dangSua ? ' dang-sua' : '' %>" data-id="<%= row.id %>" <%= row.id === sel ? '' : 'hidden' %>>
        <button type="button" class="dong-ct" data-a="dong" aria-label="Đóng">×</button>

        <div class="ct-xem">
          <div class="ct-dau"><span class="bieu"><%- t.icon %></span><h2><%= r.label(row) %></h2></div>
          <dl class="ct-ds">
            <% r.columns.slice(1).forEach(c => { %><dt><%= c.label %></dt><dd><%= c.value(row) %></dd><% }) %>
          </dl>
          <% if (row.id === sel && loi) { %><div class="bao-loi"><%= loi %></div><% } %>
          <div class="ct-xoa" hidden>
            <% if (lyDo) { %>
              <div class="bao-loi"><%= lyDo %></div>
              <div class="nut-hang"><button type="button" class="nut nut-phu" data-a="khong-xoa">Đóng</button></div>
            <% } else { %>
              <p>Xóa <%= r.singular %> <b><%= r.label(row) %></b>? Không thể hoàn tác.</p>
              <form method="post" action="/admin/<%= r.key %>/<%= row.id %>?_method=DELETE&page=<%= page %>" class="nut-hang">
                <button type="button" class="nut nut-phu" data-a="khong-xoa">Không xóa</button>
                <button class="nut">Xóa luôn</button>
              </form>
            <% } %>
          </div>
          <div class="nut-hang ct-thao-tac">
            <button type="button" class="nut nut-phu" data-a="xoa">Xóa</button>
            <button type="button" class="nut" data-a="sua">Sửa</button>
          </div>
        </div>

        <%# novalidate: để server kiểm tra và trả 400 %>
        <form method="post" enctype="multipart/form-data" novalidate class="ct-sua" action="/admin/<%= r.key %>/<%= row.id %>?_method=PATCH&page=<%= page %>">
          <h2>Sửa <%= r.singular %></h2>
          <% if (Object.keys(errors).length) { %><div class="bao-loi">Dữ liệu chưa hợp lệ, vui lòng kiểm tra lại.</div><% } %>
          <%- include('_truong', { r, values, errors, options, idp: 'e' + row.id + '-' }) %>
          <div class="nut-hang">
            <button type="button" class="nut nut-phu" data-a="huy">Hủy</button>
            <button class="nut">Lưu thay đổi</button>
          </div>
        </form>
      </section>
      <% }) %>
    </aside>
  </div>
</main>
<%- include('../partials/foot', { scripts: ['/js/admin.js', '/js/tim-kiem.js'] }) %>
