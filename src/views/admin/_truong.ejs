<%# các ô nhập của form (dùng cho trang Thêm và khung Sửa): cần r, values, errors, options, idp (tiền tố id) %>
    <% r.fields.forEach(f => { const v = values[f.name]; %>
      <div class="truong <%= errors[f.name] ? 'co-loi' : '' %>">
        <% if (f.type === 'checkbox') { %>
          <label class="check"><input type="checkbox" name="<%= f.name %>" <%= v ? 'checked' : '' %>> <%= f.label %></label>
        <% } else { %>
          <label for="<%= idp %><%= f.name %>"><%= f.label %></label>
          <% if (f.type === 'textarea') { %>
            <textarea id="<%= idp %><%= f.name %>" name="<%= f.name %>" rows="4"><%= v %></textarea>
          <% } else if (f.type === 'select') { %>
            <select id="<%= idp %><%= f.name %>" name="<%= f.name %>">
              <option value=""><%= f.placeholder || '— Không chọn —' %></option>
              <% options[f.name].forEach(o => { %>
                <option value="<%= o.value %>" <%= String(v) === o.value ? 'selected' : '' %>><%= o.label %></option>
              <% }) %>
            </select>
          <% } else if (f.type === 'multiselect') { %>
            <select id="<%= idp %><%= f.name %>" name="<%= f.name %>" multiple size="6">
              <% options[f.name].forEach(o => { %>
                <option value="<%= o.value %>" <%= (v || []).includes(o.value) ? 'selected' : '' %>><%= o.label %></option>
              <% }) %>
            </select>
            <small class="goi-y-nho">Giữ Ctrl/Cmd để chọn nhiều.</small>
          <% } else { %>
            <input type="text" id="<%= idp %><%= f.name %>" name="<%= f.name %>" value="<%= v %>" <%= f.inputmode ? `inputmode=${f.inputmode}` : '' %>>
          <% } %>
        <% } %>
        <% if (f.hint) { %><small class="goi-y-nho"><%= f.hint %></small><% } %>
        <% if (errors[f.name]) { %><small class="chu-loi"><%= errors[f.name] %></small><% } %>
      </div>
    <% }) %>
