<%# Trang xác nhận xóa (server dựng): chỉ khi bấm "Xóa luôn" mới gửi DELETE %>
<%- include('../partials/head', { title: 'Xóa ' + r.singular, am: 'bep' }) %>
<div class="nen"></div><div class="mo"></div>
<main class="man bep cuon">
  <%- include('_nav', { active: r.key }) %>
  <div class="hop hop-giua rong">
    <h2>Xác nhận xóa <%= r.singular %></h2>
    <% if (loi) { %>
      <div class="bao-loi"><%= loi %></div>
      <div class="nut-hang">
        <a class="nut" href="/admin/<%= r.key %>?sel=<%= record.id %>">Quay lại</a>
      </div>
    <% } else { %>
      <p>Bạn có chắc chắn muốn xóa <%= r.singular %> <b><%= r.label(record) %></b> không?</p>
      <p class="phu-chu-nho">Hành động này không thể hoàn tác.</p>
      <form method="post" action="/admin/<%= r.key %>/<%= record.id %>?_method=DELETE" class="nut-hang">
        <a class="nut nut-phu" href="/admin/<%= r.key %>?sel=<%= record.id %>">Không xóa</a>
        <button class="nut">Xóa luôn</button>
      </form>
    <% } %>
  </div>
</main>
<%- include('../partials/foot') %>
